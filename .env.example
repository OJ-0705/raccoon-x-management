# ── データベース（Neon / Postgres）─────────────────────────────────────────
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── ダッシュボードのログイン ──────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001
# User テーブルが空のときだけ、この値で初期管理ユーザーが作られる
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── MCPエンドポイント（/mcp）の保護 ───────────────────────────────────────
# 本番では必須。未設定のまま本番にデプロイすると /mcp は 503 で閉じる。
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_AUTH_TOKEN=

# ── cron（/api/cron/*）の保護 ─────────────────────────────────────────────
# 本番では必須。未設定だと cron エンドポイントが 503 になる。
# GitHub のリポジトリシークレットにも同じ値を CRON_SECRET として登録すること。
CRON_SECRET=

# ── X API（OAuth 1.0a user context）───────────────────────────────────────
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ── Threads API ───────────────────────────────────────────────────────────
# OAuth接続（/api/auth/threads/start）を使う場合はアプリ側のIDとシークレット
THREADS_APP_ID=
THREADS_APP_SECRET=
# 直接指定する場合（未設定なら Settings テーブルの値が使われる）
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ── 画像アップロード（Vercel Blob）────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ── 動作モード ────────────────────────────────────────────────────────────
# true にすると外部APIを叩かずに投稿を模擬する（課金なし）
SIMULATE_MODE=false

# ── X APIの単価（USD）。価格改定時のみ設定する ─────────────────────────────
# 未設定なら 2026-07 時点の公表単価が使われる
# X_PRICE_POST_CREATE=0.015
# X_PRICE_POST_CREATE_WITH_LINK=0.20
# X_PRICE_POST_READ=0.005
# X_PRICE_USER_READ=0.010
